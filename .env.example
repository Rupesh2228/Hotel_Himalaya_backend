# Backend environment variables (DO NOT commit real secrets)
# Copy this file to .env and fill in real values for production
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/hotel
# MONGODB_URI is also supported for hosts that use that name.
JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
ADMIN_EMAIL=admin@example.com
SMTP_EMAIL=you@example.com
SMTP_PASSWORD=your_smtp_password_here
